# TrafficLens Configuration
APP_NAME=TrafficLens
APP_ENV=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./trafficlens.db

# Cross-Origin Resource Sharing (CORS) - Comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Monitoring Mode: 'real' (actual network metrics) or 'demo'
MONITORING_MODE=real

# Packet Capture & Thresholds
PACKET_CAPTURE_ENABLED=true
SAMPLE_INTERVAL_SECONDS=1.0
HISTORY_RETENTION_HOURS=24
BANDWIDTH_ALERT_THRESHOLD_MBPS=50.0
TRAFFIC_LEVEL_LOW_MBPS=5.0
TRAFFIC_LEVEL_MEDIUM_MBPS=25.0
